# Token do bot (@BotFather)
TELEGRAM_BOT_TOKEN=
# Único chat aceito pelo bot
TELEGRAM_ALLOWED_CHAT_ID=
# Caminho absoluto do vault do Obsidian
VAULT_PATH=/home/ixcsoft/GitProjects/obsidian-vault
# Pasta de destino das notas dentro do vault
VAULT_SAVED_DIR=Referencias/Salvos
# Fila local
DB_PATH=data/queue.sqlite
LOG_LEVEL=INFO
# Fase 2: transcrição (faster-whisper, CPU)
WHISPER_MODEL=small
# vazio = detectar o idioma; ou pt, en...
WHISPER_LANGUAGE=
# vídeos mais longos ficam só com a legenda
MAX_AUDIO_MINUTES=30
# Fase 3: IA. Provedor ativo: anthropic, deepseek ou ollama. Vazio = sem IA
# (a nota fica em _inbox com status pendente).
LLM_PROVIDER=
LLM_TIMEOUT=60
# limite de conteúdo enviado ao modelo (caracteres)
LLM_MAX_CHARS=12000
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4
# Interface web fora desta máquina, via Tailscale Serve (vazio = só acesso local).
# Hosts aceitos, separados por vírgula (ex.: meu-pc.rede.ts.net), e e-mails que podem entrar por eles.
WEB_HOSTS=
WEB_ALLOWED_USERS=
